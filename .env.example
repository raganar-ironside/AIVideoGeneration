# Supported: mock, gemini, ollama
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
# Wikimedia requests require a descriptive user agent; include contact email before using.
WIKIMEDIA_USER_AGENT=HistoryForgeAI/0.1 (your-email@example.com)

# Narration: espeak (default), kokoro, edge, or auto
SPEECH_PROVIDER=auto
SPEECH_FALLBACK_ORDER=kokoro,edge,espeak
KOKORO_MODEL=models/kokoro-v1.0.onnx
KOKORO_VOICES=models/voices-v1.0.bin
KOKORO_VOICE=hm_omega
KOKORO_LANG=hi
KOKORO_SPEED=0.9
EDGE_TTS_VOICE=hi-IN-MadhurNeural
EDGE_TTS_RATE=-8%

# Voice mastering: normal, documentary, epic. Optional overrides below.
VOICE_PRESET=documentary
# VOICE_SPEED=0.9
# VOICE_PITCH_SEMITONES=-1.5
# VOICE_BASS_DB=2
# VOICE_SENTENCE_PAUSE=0.5
